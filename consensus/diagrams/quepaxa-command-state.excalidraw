      "groupIds": [
        "SNYMk-BNNI1uMnsC9CvPH"
      ],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 143,
      "version": 204,
      "versionNonce": 663142311,
      "isDeleted": false,
      "boundElements": [],
