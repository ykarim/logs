      "version": 3,
      "versionNonce": 1435103817,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793498319217,
      "link": null,
      "locked": false,
      "fontSize": 18,
      "fontFamily": 3,
      "text": "8. Each replica handles its own learn independently\n\nRuntime::learn(1, r1)\n  -> Node::decisions[1] = r1        // learned for this node\n  -> slot 1 is the next contiguous slot\n  -> Node::applied = 1              // applied through slot 1\n  -> Node::config[\"x\"] = \"1\"      // application state changes now\n  -> Node::results[\"r1\"] = \"ok\"    // retry/deduplication cache\n\nn3 can still be behind if its learn message has not arrived.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "8. Each replica handles its own learn independently\n\nRuntime::learn(1, r1)\n  -> Node::decisions[1] = r1        // learned for this node\n  -> slot 1 is the next contiguous slot\n  -> Node::applied = 1              // applied through slot 1\n  -> Node::config[\"x\"] = \"1\"      // application state changes now\n  -> Node::results[\"r1\"] = \"ok\"    // retry/deduplication cache\n\nn3 can still be behind if its learn message has not arrived.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "aW"
    },
