      "index": "afV"
    },
    {
      "id": "separation-text",
      "type": "text",
      "x": 1437.578125,
      "y": 842.9140625,
      "width": 460.35052490234375,
      "height": 451.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "SNYMk-BNNI1uMnsC9CvPH"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 144,
      "version": 155,
      "versionNonce": 151237193,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1793498441896,
      "link": null,
      "locked": false,
      "fontSize": 19,
      "fontFamily": 1,
      "text": "Decision is not the same as learning,\napplication, or client completion\n\nDECIDED\n  Quorum evidence fixes slot 1 = r1.\n\nLEARNED BY n2\n  n2 receives learn and stores decisions[1].\n\nAPPLIED BY n2\n  n2 has every earlier slot, executes r1,\n  and advances applied to 1.\n\nCLIENT COMPLETED\n  A response reaches the client endpoint.\n\nA response can be lost after application.\nThen the command succeeded, but history still\nlooks pending: the client has an unknown outcome.",
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Decision is not the same as learning,\napplication, or client completion\n\nDECIDED\n  Quorum evidence fixes slot 1 = r1.\n\nLEARNED BY n2\n  n2 receives learn and stores decisions[1].\n\nAPPLIED BY n2\n  n2 has every earlier slot, executes r1,\n  and advances applied to 1.\n\nCLIENT COMPLETED\n  A response reaches the client endpoint.\n\nA response can be lost after application.\nThen the command succeeded, but history still\nlooks pending: the client has an unknown outcome.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "ag"
    },
